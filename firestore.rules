rules_version = '2';

// Regras de segurança do Treino Junto (etapa 3).
// Copie tudo e cole no Console do Firebase > Firestore Database > Regras > Publicar.
//
// Resumo: cada pessoa só altera os próprios dados.
// Quem acompanha só LÊ o que a pessoa liberou, e só depois que ela aceitou o pedido.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }

    // Quem está logado acompanha "uid", com o pedido aceito e a permissão "chave" ligada
    function liberado(uid, chave) {
      let caminho = /databases/$(database)/documents/conexoes/$(uid + '_' + request.auth.uid);
      return logado() && exists(caminho)
        && get(caminho).data.status == 'aceita'
        && get(caminho).data.perm[chave] == true;
    }

    function perfilValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'email', 'codigo', 'metaPeso', 'criadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 40
        && d.codigo is string
        && (d.metaPeso == null || (d.metaPeso is number && d.metaPeso > 0 && d.metaPeso < 300));
    }

    match /users/{uid} {
      allow read: if eu(uid);
      // Ao criar, o código precisa estar reservado para esta pessoa
      allow create: if eu(uid) && perfilValido()
        && getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.uid == uid;
      // O código de conexão nunca muda depois de criado
      allow update: if eu(uid) && perfilValido() && request.resource.data.codigo == resource.data.codigo;

      match /plano/{dia} {
        allow read: if eu(uid) || liberado(uid, 'treinos');
        allow delete: if eu(uid);
        allow write: if eu(uid) && dia in ['0', '1', '2', '3', '4', '5', '6']
          && request.resource.data.keys().hasOnly(['titulo', 'exercicios'])
          && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 60
          && request.resource.data.exercicios is list && request.resource.data.exercicios.size() <= 40;
      }

      match /registros/{data} {
        allow read: if eu(uid) || liberado(uid, 'treinos');
        allow delete: if eu(uid);
        allow write: if eu(uid) && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.feitos is list && request.resource.data.feitos.size() <= 40;
      }

      // Check-ins: só a dona cria, edita a legenda e apaga.
      // Quem acompanha (com check-ins liberados) só mexe na PRÓPRIA reação.
      match /checkins/{id} {
        allow read: if eu(uid) || liberado(uid, 'checkins');
        allow create: if eu(uid)
          && request.resource.data.keys().hasOnly(['data', 'hora', 'legenda', 'temFoto', 'criadoEm', 'reacoes'])
          && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.hora is string && request.resource.data.hora.size() <= 5
          && request.resource.data.legenda is string && request.resource.data.legenda.size() <= 140
          && request.resource.data.temFoto is bool
          && request.resource.data.reacoes == {};
        allow update: if (eu(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legenda'])
            && request.resource.data.legenda is string && request.resource.data.legenda.size() <= 140)
          || (liberado(uid, 'checkins')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacoes'])
            && request.resource.data.reacoes.diff(resource.data.reacoes).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.reacoes)
                || request.resource.data.reacoes[request.auth.uid] in ['💪', '🔥', '❤️', '👏']));
        allow delete: if eu(uid);
      }

      // Fotos dos check-ins (a foto vai reduzida, bem abaixo do limite de 1 MB por documento)
      match /fotos/{id} {
        allow read: if eu(uid) || liberado(uid, 'checkins');
        allow create: if eu(uid) && request.resource.data.keys().hasOnly(['img'])
          && request.resource.data.img is string && request.resource.data.img.size() < 900000;
        allow delete: if eu(uid);
      }
    }

    // Códigos de conexão: qualquer pessoa logada pode conferir UM código (não dá para listar todos).
    // Cada um só reserva código para si mesmo, e ninguém altera nem apaga.
    match /codigos/{codigo} {
      allow get: if logado();
      allow create: if logado() && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && codigo.matches('^FIT-[A-Z0-9]{4}$');
    }

    // Conexões: o id é sempre "{quem treina}_{quem acompanha}"
    match /conexoes/{id} {
      function ehParte() {
        return logado() && (resource.data.atleta == request.auth.uid || resource.data.viewer == request.auth.uid);
      }
      function permValida(p) {
        return p.keys().hasOnly(['treinos', 'checkins', 'peso'])
          && p.treinos is bool && p.checkins is bool && p.peso is bool;
      }

      allow read: if ehParte();

      // Quem acompanha cria o pedido, sempre pendente, e precisa saber o código da pessoa
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['atleta', 'viewer', 'codigo', 'atletaNome', 'viewerNome', 'status', 'perm', 'criadoEm'])
        && request.resource.data.viewer == request.auth.uid
        && request.resource.data.atleta != request.auth.uid
        && id == request.resource.data.atleta + '_' + request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.viewerNome is string && request.resource.data.viewerNome.size() <= 40
        && permValida(request.resource.data.perm)
        && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.uid == request.resource.data.atleta;

      // Só quem treina aceita o pedido e escolhe o que libera
      allow update: if logado() && resource.data.atleta == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'perm', 'atletaNome'])
        && request.resource.data.status in ['pendente', 'aceita']
        && request.resource.data.atletaNome is string && request.resource.data.atletaNome.size() <= 40
        && permValida(request.resource.data.perm);

      // Qualquer um dos dois pode desfazer a conexão (recusar, remover ou parar de acompanhar)
      allow delete: if ehParte();

      // Recados: só as duas pessoas da conexão, e só depois do pedido aceito
      match /mensagens/{msg} {
        function conectados() {
          let c = get(/databases/$(database)/documents/conexoes/$(id)).data;
          return logado() && c.status == 'aceita' && (c.atleta == request.auth.uid || c.viewer == request.auth.uid);
        }
        allow read: if conectados();
        allow create: if conectados()
          && request.resource.data.keys().hasOnly(['de', 'texto', 'criadoEm'])
          && request.resource.data.de == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 300;
        allow delete: if logado() && resource.data.de == request.auth.uid;
      }
    }
  }
}
