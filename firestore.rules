rules_version = '2';

// Regras de segurança do Treino Junto (com e-mail confirmado obrigatório).
// Copie tudo e cole no Console do Firebase > Firestore Database > Regras > Publicar.
//
// Resumo: cada pessoa só altera os próprios dados.
// Quem acompanha só LÊ o que a pessoa liberou, e só depois que ela aceitou o pedido.

service cloud.firestore {
  match /databases/{database}/documents {

    // Conta criada (mesmo sem confirmar o e-mail): só serve para criar o próprio perfil no cadastro
    function autenticado() { return request.auth != null; }
    // Para todo o resto, o e-mail precisa estar confirmado
    function logado() { return request.auth != null && request.auth.token.email_verified == true; }
    function eu(uid) { return logado() && request.auth.uid == uid; }

    // Quem está logado acompanha "uid", com o pedido aceito e a permissão "chave" ligada
    function liberado(uid, chave) {
      let caminho = /databases/$(database)/documents/conexoes/$(uid + '_' + request.auth.uid);
      return logado() && exists(caminho)
        && get(caminho).data.status == 'aceita'
        && get(caminho).data.perm[chave] == true;
    }

    function perfilValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'email', 'codigo', 'metaPeso', 'criadoEm', 'avisos', 'alturaCm', 'horaLembrete', 'conquistas', 'boasVindas'])
        && (!('conquistas' in d) || (d.conquistas is map && d.conquistas.size() <= 60))
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 40
        && d.codigo is string
        && (!('alturaCm' in d) || d.alturaCm == null || (d.alturaCm is number && d.alturaCm >= 100 && d.alturaCm <= 230))
        && (!('horaLembrete' in d) || (d.horaLembrete is int && d.horaLembrete >= 6 && d.horaLembrete <= 22))
        && (!('avisos' in d) || (d.avisos is map
            && d.avisos.keys().hasOnly(['checkin', 'lembrete', 'meuLembrete', 'recados', 'reacoes', 'resumo', 'conquistas'])))
        && (d.metaPeso == null || (d.metaPeso is number && d.metaPeso > 0 && d.metaPeso < 300));
    }

    match /users/{uid} {
      allow read: if autenticado() && request.auth.uid == uid; // o cadastro confere se o perfil já existe
      // Ao criar, o código precisa estar reservado para esta pessoa
      allow create: if autenticado() && request.auth.uid == uid && perfilValido()
        && getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.uid == uid;
      // O código de conexão nunca muda depois de criado
      allow update: if eu(uid) && perfilValido() && request.resource.data.codigo == resource.data.codigo;
      // Apagar a conta (LGPD): a própria pessoa apaga o perfil
      allow delete: if eu(uid);

      match /plano/{dia} {
        allow read: if eu(uid) || liberado(uid, 'treinos');
        allow delete: if eu(uid);
        allow write: if eu(uid) && dia in ['0', '1', '2', '3', '4', '5', '6']
          && request.resource.data.keys().hasOnly(['titulo', 'exercicios', 'desde'])
          && (!('desde' in request.resource.data) || request.resource.data.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 60
          && request.resource.data.exercicios is list && request.resource.data.exercicios.size() <= 40;
      }

      match /registros/{data} {
        allow read: if eu(uid) || liberado(uid, 'treinos');
        allow delete: if eu(uid);
        allow write: if eu(uid) && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['feitos', 'atualizadoEm', 'cargas'])
          && (!('feitos' in request.resource.data) || (request.resource.data.feitos is list && request.resource.data.feitos.size() <= 40))
          && (!('cargas' in request.resource.data) || (request.resource.data.cargas is map && request.resource.data.cargas.size() <= 40));
      }

      // Fotos de antes e depois: privadas, só a dona vê
      match /fotosProgresso/{data} {
        allow read, delete: if eu(uid);
        allow write: if eu(uid) && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['img'])
          && request.resource.data.img is string && request.resource.data.img.size() < 900000;
      }

      // Check-ins: só a dona cria, edita a legenda e apaga.
      // Quem acompanha (com check-ins liberados) só mexe na PRÓPRIA reação.
      match /checkins/{id} {
        allow read: if eu(uid) || liberado(uid, 'checkins');
        allow create: if eu(uid)
          && request.resource.data.keys().hasOnly(['data', 'hora', 'legenda', 'temFoto', 'criadoEm', 'reacoes'])
          && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.hora is string && request.resource.data.hora.size() <= 5
          && request.resource.data.legenda is string && request.resource.data.legenda.size() <= 140
          && request.resource.data.temFoto is bool
          && request.resource.data.reacoes == {};
        allow update: if (eu(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legenda'])
            && request.resource.data.legenda is string && request.resource.data.legenda.size() <= 140)
          || (liberado(uid, 'checkins')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacoes'])
            && request.resource.data.reacoes.diff(resource.data.reacoes).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.reacoes)
                || request.resource.data.reacoes[request.auth.uid] in ['💪', '🔥', '❤️', '👏']));
        allow delete: if eu(uid);
      }

      // Peso: só a dona registra; quem acompanha vê só com "Ver meu peso" ligado
      match /pesos/{data} {
        allow read: if eu(uid) || liberado(uid, 'peso');
        allow delete: if eu(uid);
        allow write: if eu(uid) && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['kg', 'criadoEm'])
          && request.resource.data.kg is number
          && request.resource.data.kg >= 20 && request.resource.data.kg <= 300;
      }

      // Medidas do corpo: privadas, só a dona vê
      match /medidas/{data} {
        allow read, delete: if eu(uid);
        allow write: if eu(uid) && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['cintura', 'quadril', 'braco', 'criadoEm'])
          && (!('cintura' in request.resource.data) || (request.resource.data.cintura is number && request.resource.data.cintura < 300))
          && (!('quadril' in request.resource.data) || (request.resource.data.quadril is number && request.resource.data.quadril < 300))
          && (!('braco' in request.resource.data) || (request.resource.data.braco is number && request.resource.data.braco < 300));
      }

      // Fotos dos check-ins (a foto vai reduzida, bem abaixo do limite de 1 MB por documento)
      match /fotos/{id} {
        allow read: if eu(uid) || liberado(uid, 'checkins');
        allow create: if eu(uid) && request.resource.data.keys().hasOnly(['img'])
          && request.resource.data.img is string && request.resource.data.img.size() < 900000;
        allow delete: if eu(uid);
      }
    }

    // Códigos de conexão: qualquer pessoa logada pode conferir UM código (não dá para listar todos).
    // Cada um só reserva código para si mesmo, e ninguém altera nem apaga.
    match /codigos/{codigo} {
      allow get: if autenticado();
      allow create: if autenticado() && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && codigo.matches('^FIT-[A-Z0-9]{4}$');
      allow delete: if logado() && resource.data.uid == request.auth.uid; // ao apagar a conta
    }

    // Sugestões: qualquer pessoa com conta confirmada envia; ninguém lê pelo app
    // (quem mantém o app vê no Console do Firebase e na planilha de backup)
    match /sugestoes/{id} {
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'tipo', 'texto', 'versao', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['ideia', 'problema']
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000;
    }

    // Aparelhos que recebem avisos: o id é o código do aparelho no Firebase Cloud Messaging.
    // Cada pessoa só cadastra aparelho para si mesma (se outra conta entrar no mesmo celular, ele passa para ela).
    match /dispositivos/{token} {
      allow read, delete: if logado() && resource.data.uid == request.auth.uid;
      allow create, update: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'atualizadoEm'])
        && request.resource.data.uid == request.auth.uid;
    }

    // Conexões: o id é sempre "{quem treina}_{quem acompanha}"
    match /conexoes/{id} {
      function ehParte() {
        return logado() && (resource.data.atleta == request.auth.uid || resource.data.viewer == request.auth.uid);
      }
      function permValida(p) {
        return p.keys().hasOnly(['treinos', 'checkins', 'peso'])
          && p.treinos is bool && p.checkins is bool && p.peso is bool;
      }

      allow read: if ehParte();

      // Quem acompanha cria o pedido, sempre pendente, e precisa saber o código da pessoa
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['atleta', 'viewer', 'codigo', 'atletaNome', 'viewerNome', 'status', 'perm', 'criadoEm'])
        && request.resource.data.viewer == request.auth.uid
        && request.resource.data.atleta != request.auth.uid
        && id == request.resource.data.atleta + '_' + request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.viewerNome is string && request.resource.data.viewerNome.size() <= 40
        && permValida(request.resource.data.perm)
        && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.uid == request.resource.data.atleta;

      // Só quem treina aceita o pedido e escolhe o que libera
      allow update: if logado() && resource.data.atleta == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'perm', 'atletaNome', 'alturaCm'])
        && request.resource.data.status in ['pendente', 'aceita']
        && (!('alturaCm' in request.resource.data) || request.resource.data.alturaCm == null
            || (request.resource.data.alturaCm is number && request.resource.data.alturaCm >= 100 && request.resource.data.alturaCm <= 230))
        && request.resource.data.atletaNome is string && request.resource.data.atletaNome.size() <= 40
        && permValida(request.resource.data.perm);

      // Quem acompanha só pode atualizar o próprio nome (quando troca no Perfil)
      allow update: if logado() && resource.data.viewer == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerNome'])
        && request.resource.data.viewerNome is string && request.resource.data.viewerNome.size() <= 40;

      // Meta do casal: qualquer um dos dois combina ou muda a meta do mês
      allow update: if ehParte() && resource.data.status == 'aceita'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meta'])
        && request.resource.data.meta.keys().hasOnly(['mes', 'treinos', 'recompensa', 'batida'])
        && request.resource.data.meta.mes.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.meta.treinos is int
        && request.resource.data.meta.treinos >= 1 && request.resource.data.meta.treinos <= 31
        && request.resource.data.meta.recompensa is string && request.resource.data.meta.recompensa.size() <= 60
        && request.resource.data.meta.batida is bool;

      // Qualquer um dos dois pode desfazer a conexão (recusar, remover ou parar de acompanhar)
      allow delete: if ehParte();

      // Recados antigos (o chat foi tirado do app): ninguém cria mais; só dá para ler e apagar
      // (o "Apagar minha conta" limpa as conversas que sobraram)
      match /mensagens/{msg} {
        function conectados() {
          let c = get(/databases/$(database)/documents/conexoes/$(id)).data;
          return logado() && c.status == 'aceita' && (c.atleta == request.auth.uid || c.viewer == request.auth.uid);
        }
        allow read: if conectados();
        allow delete: if logado() && (resource.data.de == request.auth.uid
          || get(/databases/$(database)/documents/conexoes/$(id)).data.atleta == request.auth.uid
          || get(/databases/$(database)/documents/conexoes/$(id)).data.viewer == request.auth.uid);
      }
    }
  }
}
